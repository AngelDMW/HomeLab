# Media, downloads and media libraries
media/
/media
downloads/
peliculas/
series/

# Docker volumes and app data (config, cache, databases)
docker/**/config/
docker/**/cache/
docker/**/data/
docker/jellyfin/cache/
docker/jellyfin/config/
docker/media-stack/jellyfin/
docker/media-stack/jellyseerr/
docker/media-stack/prowlarr/
docker/media-stack/radarr/
docker/media-stack/sonarr/
docker/media-stack/qbittorrent/

# Sensitive secrets, tokens, credentials and environments
.env
.env.*
!.env.example
*.key
*.pem
*.token
*.json.secret

# Application configs with credentials
config.xml

# Databases and cache
*.db
*.db*
*.sqlite*
*.sqlite3

# Logs and runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/

# Backups
backups-compose/
*.bak
*.backup

# OS metadata
.DS_Store
Thumbs.db

# Immich runtime data (keep compose/config examples only)
docker/immich/library/
docker/immich/postgres/
docker/immich/backups/
docker/immich/backup_to_node2.log

# Threadfin runtime state (provider data, EPG cache, auth token)
docker/threadfin/conf/
docker/threadfin/temp/
docker/threadfin/.env

# Artefactos de ejecucion / estado no versionable detectados en auditoria
docker/media-stack/bazarr/
docker/threadfin/logs/
docker/threadfin/__pycache__/
docker/threadfin/.sync.lock
docker/threadfin/root_crontab.new
docker/threadfin/apply_settings.py
__pycache__/
*.pyc

# GitOps: llave SSH dedicada Nodo 2 -> Nodo 1 (nunca versionar)
docker/ai-corp/ssh/*
!docker/ai-corp/ssh/.gitkeep
