    {
      "id": "merge4",
      "name": "Consolidar entregas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "parameters": {
        "jsCode": "const labels = ['Infra','SecOps','Media','Cloud','Updater','Backup','Architect'];\nconst reports = labels.map(label => {\n  const items = $items('Agente ' + label);\n  if (items.length) return items[0].json;\n  return {employee:'Agent-'+label, severity:'CRIT', quality_score:0,\n          summary:'Sin respuesta del sub-workflow', findings:[], report_id:null};\n});\nconst p = $('Preparar directiva').first().json || {};\nconst prompt = `Eres HomeLab-Director. Recibiste siete entregas de tus empleados.\nPrepara el contexto para Agent-QA, que auditará la calidad y la auditoría de Sentinel.\nNo escribas aún el reporte ejecutivo.\n\nDIRECTIVA: ${p.directive}\nRONDA: ${p.round_id}\nENTREGAS:\n${JSON.stringify(reports.map(r=>({employee:r.employee, severity:r.severity, summary:r.summary,\n  findings:r.findings, report_id:r.report_id, evidence:(r.evidence||'').slice(0,1200)})))}\n`;\nreturn [{json:{reports, directive:p.directive, task_id:p.task_id,\n  round_id:p.round_id, source:p.source, prompt}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "qa",
      "name": "Agente QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-qa",
        "sendHeaders": false,
        "options": {
          "timeout": 150000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
