        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ directive: (($json.body || $json).directive || 'Ejecuta una ronda inicial de inspección con los 8 empleados y entrega el primer reporte ejecutivo'), employee: 'HomeLab-Director', requested_by: (($json.body || $json).requested_by || ((($json.body || $json).mode === 'code_change') ? 'telegram_user' : 'schedule')) }) }}"
