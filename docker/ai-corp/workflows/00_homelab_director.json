      "id": "gitops_if_director",
      "name": "¿Cambio de código en repo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        350,
        -220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.4:8006/api/tools/repo/apply-change",
        "sendHeaders": true,
        "options": {
          "timeout": 300000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Corp-Token",
              "value": "={{ $env.CORP_INTERNAL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ directive: $('Preparar directiva').first().json.directive, requested_by: 'telegram_user' }) }}"
      },
      "id": "gitops_apply_director",
      "name": "GitOps aplicar cambio (Director)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        -320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $('GitOps aplicar cambio (Director)').first().json || {};\nconst p = $('Preparar directiva').first().json || {};\nconst OK = r.ok === true;\nconst files = (r.files || []).join(', ') || 'sin cambios';\nconst audit = r.audit_after || {};\nconst lines = [\n  OK ? '✅ <b>CAMBIO GITOPS APLICADO POR EL DIRECTOR</b>' : '⚠️ <b>CAMBIO GITOPS NO APLICADO</b>',\n  'Directiva: ' + String(p.directive || '').slice(0, 500),\n  'Archivos: ' + files,\n  'Commit: ' + (r.commit_hash || 'sin commit'),\n  'Sondas Sentinel: ' + (audit.probes_total || 'n/d') + ' · anomalías nuevas: ' + (r.new_anomalies || []).length,\n  r.rollback ? 'Rollback automático ejecutado.' : 'Rollback: no requerido.',\n  String(r.summary || r.error || '').slice(0, 900)\n];\nreturn [{json: {\n  ok: OK,\n  round_id: p.round_id || null,\n  task_id: p.task_id || null,\n  report: lines.join('\\n'),\n  scores: [],\n  gitops: {\n    commit_hash: r.commit_hash || null,\n    files: r.files || [],\n    rollback: !!r.rollback,\n    probes_total: audit.probes_total || null,\n    anomaly_count: (r.new_anomalies || []).length\n  }\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "gitops_reply_director",
      "name": "Respuesta GitOps Director",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -320
      ]
    },
    {
      "parameters": {
