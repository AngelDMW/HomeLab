{
  "name": "HomeLab Corp — Director",
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook Director",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "director",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "11111111-1111-4111-8111-111111111111"
    },
    {
      "id": "cron",
      "name": "Cron 08:00 y 20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        260
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8,20 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "task",
      "name": "Abrir tarea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://corp-tools-api:8006/api/ledger/task",
        "sendHeaders": true,
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Corp-Token",
              "value": "={{ $env.CORP_INTERNAL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ directive: $json.directive || 'Ejecuta una ronda inicial de inspección con los 5 empleados y entrega el primer reporte ejecutivo', employee: 'HomeLab-Director', requested_by: $json.requested_by || ($('Webhook Director').length ? 'telegram' : 'schedule') }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "prep",
      "name": "Preparar directiva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "jsCode": "const task = $('Abrir tarea').first().json || {};\nconst hook = $('Webhook Director').length ? $('Webhook Director').first().json : {};\nconst directive = hook.directive || task.directive || 'Ejecuta una ronda inicial de inspección con los 5 empleados y entrega el primer reporte ejecutivo';\nreturn [{json:{\n  directive,\n  task_id: task.task_id || null,\n  round_id: 'CORP-' + new Date().toISOString().replace(/[-:TZ.]/g,'').slice(0,14),\n  requested_by: hook.requested_by || ($('Webhook Director').length ? 'telegram' : 'schedule'),\n  source: $('Webhook Director').length ? 'webhook' : 'schedule'\n}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "call_infra",
      "name": "Agente Infra",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-infra",
        "sendHeaders": false,
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Preparar directiva').first().json) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "call_secops",
      "name": "Agente SecOps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-secops",
        "sendHeaders": false,
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Preparar directiva').first().json) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "call_media",
      "name": "Agente Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-media",
        "sendHeaders": false,
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
