      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "call_cloud",
      "name": "Agente Cloud",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-cloud",
        "sendHeaders": false,
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Preparar directiva').first().json) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "merge4",
      "name": "Consolidar entregas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "parameters": {
        "jsCode": "const labels = ['Infra','SecOps','Media','Cloud'];\nconst reports = labels.map(label => {\n  const items = $items('Agente ' + label);\n  if (items.length) return items[0].json;\n  return {employee:'Agent-'+label, severity:'CRIT', quality_score:0,\n          summary:'Sin respuesta del sub-workflow', findings:[], report_id:null};\n});\nconst p = $('Preparar directiva').first().json || {};\nconst prompt = `Eres HomeLab-Director. Recibiste cuatro entregas de tus empleados.\nPrepara el contexto para Agent-QA, que auditará la calidad y la auditoría de Sentinel.\nNo escribas aún el reporte ejecutivo.\n\nDIRECTIVA: ${p.directive}\nRONDA: ${p.round_id}\nENTREGAS:\n${JSON.stringify(reports.map(r=>({employee:r.employee, severity:r.severity, summary:r.summary,\n  findings:r.findings, report_id:r.report_id, evidence:(r.evidence||'').slice(0,1200)})))}\n`;\nreturn [{json:{reports, directive:p.directive, task_id:p.task_id,\n  round_id:p.round_id, source:p.source, prompt}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "qa",
      "name": "Agente QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/agent-qa",
        "sendHeaders": false,
        "options": {
          "timeout": 150000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Consolidar entregas').first().json) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "merge5",
      "name": "Consolidar final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        200
      ],
      "parameters": {
        "jsCode": "const base = $('Consolidar entregas').first().json || {};\nconst qa = $('Agente QA').first().json || {};\nconst reports = [...(base.reports || []), {\n  employee:'Agent-QA', severity:qa.severity || 'WARN',\n  quality_score:qa.quality_score || 0, summary:qa.summary || 'Sin dictamen',\n  findings:qa.findings || [], report_id:qa.report_id || null\n}];\nconst scores = (qa.assessments || []).map(a => ({\n  report_id:a.report_id, quality_score:a.quality_score, reason:a.reason\n})).filter(s => s.report_id);\nconst prompt = `Eres HomeLab-Director de HomeLab Corp, una organización de 5 IAs\nempleadas. Redacta el REPORTE EJECUTIVO CONSOLIDADO para @ServerDMW_bot en español,\nen 8 a 12 líneas de texto plano, con:\n1) estado general del clúster, 2) un bloque por cada empleado con su hallazgo principal,\n3) anomalías/riesgos detectados por QA, 4) próximos pasos seguros de solo lectura.\nSé concreto y usa los datos reales. No inventes nada. No propongas reinicios ni borrados.\nNo incluyas claves, tokens ni rutas de credenciales.\n\nDIRECTIVA RECIBIDA: ${base.directive}\nRONDA: ${base.round_id}\nINFORMES:\n${JSON.stringify(reports.map(r=>({employee:r.employee, severity:r.severity,\n  quality_score:r.quality_score, summary:r.summary, findings:r.findings})))}\n\nPUNTAJES QA:\n${JSON.stringify(scores)}\n`;\nreturn [{json:{reports, scores, directive:base.directive, task_id:base.task_id,\n  round_id:base.round_id, source:base.source, qa, prompt}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "llm",
      "name": "LLM Director",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "HTTP-Referer",
              "value": "http://192.168.1.4:5678"
            },
            {
              "name": "X-Title",
              "value": "HomeLab Corp"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENROUTER_MODEL || 'google/gemini-2.5-flash', temperature: 0.25, max_tokens: 800, messages: [{role:'system', content:'Responde siempre en español. Sé preciso, breve y accionable. Usa solo texto plano, sin Markdown. No inventes datos y nunca menciones claves, tokens ni rutas de credenciales. No propongas reiniciar contenedores ni borrar datos: esta plataforma es solo de diagnóstico.'},{role:'user', content: $('Consolidar final').first().json.prompt}] }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "narrative",
      "name": "Narrativa Director",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "jsCode": "const c = $('Consolidar final').first().json || {};\nconst l = $('LLM Director').first().json || {};\nconst choice = (l.choices || [])[0];\nlet text = ((choice && choice.message && choice.message.content) || '').trim();\nif (!text) {\n  const lines = (c.reports || []).map(r =>\n    '• ' + r.employee + ' [' + r.severity + '] ' + (r.summary || '').slice(0,220));\n  text = ['Estado general: consolidación completada con datos de Sentinel y los 5 empleados.',\n    ...lines, 'Próximos pasos: mantener vigilancia de solo lectura y auditar en la próxima ronda.'].join('\\n');\n}\nconst header = '🏢 HomeLab Corp · Reporte ejecutivo\\nRonda ' + (c.round_id || 'n/a') + '\\n\\n';\nreturn [{json:{text:(header + text).slice(0,3800), round_id:c.round_id,\n  task_id:c.task_id, scores:c.scores || []}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "telegram",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2020,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_TOKEN }}/sendMessage",
        "sendHeaders": false,
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.CORP_TELEGRAM_CHAT_ID, text: $('Narrativa Director').first().json.text, disable_web_page_preview: true }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "score",
      "name": "Calificar informes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://corp-tools-api:8006/api/ledger/score",
        "sendHeaders": true,
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Corp-Token",
              "value": "={{ $env.CORP_INTERNAL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scores: $('Consolidar final').first().json.scores || [] }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "close",
      "name": "Cerrar tarea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2460,
        200
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=http://corp-tools-api:8006/api/ledger/task/{{ $('Narrativa Director').first().json.task_id }}",
        "sendHeaders": true,
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Corp-Token",
              "value": "={{ $env.CORP_INTERNAL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status:'completed', result: $('Narrativa Director').first().json.text }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "reply",
      "name": "Responder Director",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2680,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok:true, round_id: $('Narrativa Director').first().json.round_id, task_id: $('Narrativa Director').first().json.task_id, report: $('Narrativa Director').first().json.text, scores: $('Narrativa Director').first().json.scores }) }}",
        "options": {}
      }
    }
  ],
