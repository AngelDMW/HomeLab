# HomeLab Sentinel AI
SENTINEL_PORT=9090
SENTINEL_HOST=0.0.0.0
SENTINEL_DB=/app/data/sentinel.db
SENTINEL_PUBLIC_URL=http://192.168.1.3:9090
SENTINEL_TZ=America/Santo_Domingo

# LLM (optional). Provider: gemini | openrouter | openai
SENTINEL_LLM_PROVIDER=
SENTINEL_API_KEY=
SENTINEL_LLM_MODEL=

# Notifications (Tier 2 approvals)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Security: secret for signing approve/ignore action links (change in .env)
SENTINEL_ACTION_SECRET=change-me-to-a-random-secret

# Paths (container defaults)
THREADFIN_LOGS_DIR=/threadfin_logs
THREADFIN_BASE=/homelab/docker/threadfin
HOSTFS=/hostfs
